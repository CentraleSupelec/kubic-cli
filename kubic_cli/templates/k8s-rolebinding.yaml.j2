apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: [[ user ]]
  namespace: [[ slug if slug == env else slug + '-' + env ]]
subjects:
  - kind: ServiceAccount
    name: [[ user ]]
    namespace: default
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
